# ===== Security baseline: keep secrets and local state out of git. =====
# The secrets scan in CI (where present) is the second layer; this file is the first.

# --- Secrets and environment files ---
.env
.env.*
!.env.example
*.secret
*.secrets
secrets/
credentials*
*credentials.json
service-account*.json
.doppler*
.vault-token

# --- Keys and certificates ---
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
id_rsa*
id_ed25519*
id_ecdsa*
*.gpg
*.asc

# --- Cloud and tool credentials ---
.aws/
.azure/
.gcloud/
.kube/
kubeconfig*
.npmrc
.pypirc
.netrc
.git-credentials
.docker/config.json
*.tfvars
*.tfvars.json
*.tfstate
*.tfstate.*
.terraform/
.cloudflared/
cert.pem

